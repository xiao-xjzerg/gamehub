# Set these in the shell/service environment; this file is not loaded automatically.
PORT=8001
# Separate loopback-only statistics service (4174 in local dev, 8002 in production).
GAMEHUB_ADMIN_PORT=8002
# Use one absolute persistent path outside versioned code releases in production.
GAMEHUB_DB=/opt/gamehub/data/gamehub.sqlite
GAMEHUB_ORIGIN=http://127.0.0.1:8001
# Enable only when Nginx overwrites X-Real-IP and the app remains loopback-only.
GAMEHUB_TRUST_PROXY=false
# Set true only behind HTTPS.
GAMEHUB_SECURE_COOKIE=false
