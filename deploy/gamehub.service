[Unit]
Description=GameHub portal and private administration
After=network.target

[Service]
Type=simple
User=gamehub
Group=gamehub
WorkingDirectory=/opt/gamehub/current/app
EnvironmentFile=/etc/gamehub/gamehub.env
Environment=TZ=Asia/Shanghai
ExecStart=/opt/gamehub/runtime/node-v26.10.0-linux-x64/bin/node /opt/gamehub/current/app/server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gamehub/data /opt/gamehub/backups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
